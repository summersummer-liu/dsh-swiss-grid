{
  "name": "dsh-swiss-grid",
  "version": "1.1.0",
  "description": "Swiss grid layout system for DeepSeek Harness — compute 版心, columns, baseline and type scale, then build print-ready SVG-to-PDF posters, books, magazines and exhibition graphics with a grid-overlay proof.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
